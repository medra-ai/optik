<robot name="fixed_origin_order">
  <link name="world"/>
  <link name="base"/>
  <link name="moving"/>
  <link name="tip"/>
  <joint name="mount" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
  </joint>
  <joint name="j1" type="revolute">
    <parent link="base"/>
    <child link="moving"/>
    <origin xyz="0 0 0" rpy="0 0 1.5707963267948966"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="1" velocity="1"/>
  </joint>
  <joint name="tool" type="fixed">
    <parent link="moving"/>
    <child link="tip"/>
    <origin xyz="0.1 0 0" rpy="0 0 0"/>
  </joint>
</robot>
